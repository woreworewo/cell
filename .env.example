# =====================================================================
# Unwired Labs
# =====================================================================
# Token gratis 100 lookup/hari per akun. Boleh banyak token, dipisah
# koma. Script otomatis rotate kalau salah satu kena limit.
UWL_TOKEN=pk.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,pk.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# =====================================================================
# OpenCellID (update database harian + fallback lookup)
# =====================================================================
# Token dari https://my.opencellid.org/dashboard (format pk.xxx).
# Dipakai untuk dua hal:
#   1. update_db.py — unduh file negara. Tiap file boleh diunduh 2x/hari.
#   2. Fallback lookup (cell_lookup.py / bot.py) — endpoint /cell/get,
#      jatah 1.000 request/hari per key. Dicoba setelah database lokal
#      dan cache, tapi SEBELUM Unwired Labs karena kuotanya 10x lebih
#      besar dan sumbernya sama dengan database lokal.
# Boleh banyak token, dipisah koma — otomatis rotate kalau kena limit.
#
# Catatan: endpoint lookup OpenCellID mewajibkan LAC/TAC. Kalau user
# hanya memberi eNB + sektor tanpa TAC, lapisan ini dilewati dan
# langsung ke Unwired Labs.
OCID_TOKEN=pk.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Set 0 kalau ingin menyimpan kuota OpenCellID hanya untuk unduhan
# database harian (mematikan fallback lookup-nya).
OCID_LOOKUP=1

# Default MCC untuk update_db.py (510 = Indonesia)
OCID_MCC=510

# =====================================================================
# Telegram bot (opsional - hanya kalau pakai bot.py)
# =====================================================================
# Token bot dari @BotFather
TG_BOT_TOKEN=

# Nama bot (muncul di /start, /help)
TG_BOT_NAME=LTE Cell Lookup

# Rate limit per user, dalam detik. Default 3 detik (anti-spam ringan).
# Bisa diset 0 untuk mematikan limit sama sekali jika bot dipakai pribadi.
TG_RATE_LIMIT_SEC=3

# Default MCC/MNC kalau user pakai /cell <enb> <cid> tanpa MCC/MNC
TG_DEFAULT_MCC=510
TG_DEFAULT_MNC=10

# Toggle bagian output (1/0, true/false)
TG_INCLUDE_LOCATION=1     # kirim Telegram Location native
TG_INCLUDE_ADDRESS=1      # tampilkan alamat
TG_INCLUDE_MAP_BUTTONS=1  # tombol Google/OSM/Bing/Waze/Apple
TG_INCLUDE_PLUS_CODE=1    # tampilkan Plus Code
TG_INCLUDE_AZIMUTH=1      # tampilkan estimasi arah pancar sektor

# --- Khusus /batch -----------------------------------------------------
# Hasil /batch dikirim sebagai file .txt. Nominatim (sumber alamat)
# membatasi ~1 request/detik, jadi alamat hanya diambil untuk N cell
# pertama per batch; sisanya tetap dapat koordinat + link Google Maps.
# 0 = matikan alamat di /batch (paling cepat).
TG_BATCH_GEOCODE_MAX=5

# Panjang maksimal satu baris alamat di file (karakter). Segmen yang
# tidak muat dibuang utuh, tidak dipotong di tengah kata.
TG_BATCH_ADDR_MAXLEN=70

# =====================================================================
# Estimasi azimuth sektor (opsional)
# =====================================================================
# Mayoritas eNB LTE 3-sektor dengan antena 120° terpisah. Default
# mengasumsikan sektor 1=0° (Utara), 2=120°, 3=240°. Override global:
#
#   SECTOR_AZIMUTHS=30,150,270
#
# Atau per-operator pakai SECTOR_AZIMUTHS_<MCC>_<MNC> (MNC 2 digit):
#
#   SECTOR_AZIMUTHS_510_10=0,120,240   # Telkomsel
#   SECTOR_AZIMUTHS_510_11=30,150,270  # XL
#
# Nilai ini cuma estimasi karena setiap site di lapangan bisa di-tilt
# sesuai topografi. Tetap berguna sebagai panduan kasar.
#SECTOR_AZIMUTHS=0,120,240
